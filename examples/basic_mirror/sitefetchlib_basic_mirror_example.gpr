with "config/sitefetchlib_basic_mirror_example_config.gpr";

project Sitefetchlib_Basic_Mirror_Example is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sitefetchlib_Basic_Mirror_Example_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("basic_mirror.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Sitefetchlib_Basic_Mirror_Example_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Sitefetchlib_Basic_Mirror_Example_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto", "-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
      end case;
   end Linker;

end Sitefetchlib_Basic_Mirror_Example;
